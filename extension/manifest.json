{
  "manifest_version": 3,
  "name": "ClipGuard",
  "version": "1.0.0",
  "description": "Free clipboard protection: warns when pasted text differs from a recent observed copy.",
  "permissions": ["storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }]
}
